[Unit]
Description=PrivacyTests live results API (3335 + websocket 3336)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<SERVICE_USER>
Group=<SERVICE_GROUP>
WorkingDirectory=<REPO_ROOT>
Environment=NODE_ENV=production
ExecStart=/usr/bin/node live/results.js
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
